# Copy to .env (or set in your MCP client's `env:` block). All vars
# are optional — defaults point at jsonplaceholder.typicode.com so
# the server runs without any setup.

# ──── The API you're wrapping ─────────────────────────────────────────
API_BASE_URL=https://jsonplaceholder.typicode.com
API_HEALTH_PATH=/posts/1
API_OPENAPI_PATH=/openapi.json

# ──── Names advertised over MCP ───────────────────────────────────────
MCP_SERVER_NAME=mcp-api-template
MCP_SERVER_VERSION=0.1.0

# ──── Auth (pick one — or neither if every endpoint is public) ────────
#
# 1. Static Bearer token:
# BEARER_TOKEN=eyJhbGciOi...
#
# 2. OAuth2 client_credentials grant with token caching:
# OAUTH_TOKEN_URL=https://auth.example.com/oauth2/token
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
